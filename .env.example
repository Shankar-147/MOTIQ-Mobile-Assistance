# Copy this file to apps/api/.env and fill in real local values.
# Never commit a real .env file. See docs/security.md.

# --- Database (apps/api) ---
# PostGIS extension must be enabled on this database — see docs/development.md
DATABASE_URL="postgresql://motiq:motiq@localhost:5432/motiq_dev?schema=public"
# A second, persistent database with PostGIS also enabled on it, used only by
# `prisma migrate dev`'s shadow-database validation step. Prisma's default
# (a fresh throwaway shadow DB per run) doesn't have PostGIS, and `Unsupported`
# geography columns (ADR 0002) fail to validate without it — a documented
# Prisma+PostGIS interaction, not a bug in this schema. If `migrate dev` still
# reports a missing "geography" type, the shadow DB's PostGIS got dropped
# (Prisma resets its schema each run) — re-run `CREATE EXTENSION postgis;`
# against it, or use `prisma db push` instead for that one change (see
# docs/development.md).
SHADOW_DATABASE_URL="postgresql://motiq:motiq@localhost:5432/motiq_shadow?schema=public"

# --- Auth (Ch33, Ch50, Ch51 — see docs/decisions/0011-*.md) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
# Refresh tokens are opaque random strings stored hashed in the DB, not JWTs
# (ADR 0011), so there's no JWT_REFRESH_SECRET — only how long one lasts:
JWT_REFRESH_TTL="30d"

# One-time dev bootstrap: prisma/seed.ts creates admin@motiq.dev with this
# password. Admin/Support accounts are never created via public
# self-registration (Ch33) — this is the dev-environment stand-in for
# whatever out-of-band provisioning process a real deployment uses.
ADMIN_SEED_PASSWORD="replace-with-a-strong-local-dev-password"

# --- Redis (Ch44's provider-availability cache — not implemented yet; and
#     Ch75's WebSocket horizontal-scaling adapter — implemented, degrades to
#     single-instance if unset/unreachable, see common/redis-io.adapter.ts) ---
REDIS_URL="redis://localhost:6379"

# --- Real-time tracking (Ch54, Ch76, Ch77 — provisional defaults) ---
LOCATION_UPDATE_MIN_INTERVAL_MS="3000"

# --- Commission (ADR 0003 — this is a bootstrap-time seed default only.
#     The real, live value is a database row (CommissionRate), never read from env at runtime.) ---
DEFAULT_COMMISSION_RATE_PERCENT="15"

# --- Fare (Ch56, ADR 0012 — same bootstrap-time seed default pattern as
#     commission above. The real, live values are a database row (FareConfig),
#     never read from env at runtime.) ---
DEFAULT_BASE_FARE="50.00"
DEFAULT_PER_KM_RATE="10.00"

# --- Matching (Ch53, ADR 0013 — provisional defaults, see docs/decisions/) ---
MATCHING_OFFER_TIMEOUT_SECONDS="90"
MATCHING_SEARCH_RADIUS_METERS="10000"

# --- Routing (Ch32/ADR 0012 — real driving routes). Defaults to OSRM's free
#     public demo server: no API key, no billing account, but rate-limited
#     and not meant for production traffic. Point this at a self-hosted or
#     commercial OSRM/OpenRouteService instance before a real launch. ---
OSRM_BASE_URL="https://router.project-osrm.org"

# --- Provider re-verification cadence (Ch98, ADR 0016 — provisional defaults) ---
PROVIDER_PROVISIONAL_REVERIFICATION_DAYS="30"
PROVIDER_FULLY_VERIFIED_REVERIFICATION_DAYS="180"

# --- Third-party integrations (Ch32) — left blank; no real gateway is
#     configured in this bootstrap phase, so Payment settles as PENDING with
#     no gateway order (see docs/decisions/0014-*.md's "not configured" path).
MAPS_PROVIDER_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Notification Service (Ch59, Ch70, Ch79, ADR 0017) — left blank; SMS/push
#     sends degrade to a logged fallback until these are configured (see
#     NotificationService, TwilioSmsGatewayAdapter, FcmPushGatewayAdapter). ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# FCM HTTP v1 API (service account) — Firebase Console > Project settings >
# Service accounts > Generate new private key. FCM_PRIVATE_KEY keeps the
# downloaded JSON's "\n" line-break escapes literally (a real newline isn't
# representable in a single env-file line); the adapter unescapes them.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Security hardening (Ch93-95, ADR 0020) ---
# AES-256-GCM field-level encryption key (Ch94) — 32 bytes, hex-encoded (64
# hex characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No real KMS in this bootstrap environment — see ADR 0020's honest gap note.
ENCRYPTION_MASTER_KEY=""
# Comma-separated list of allowed CORS origins (main.ts).
CORS_ORIGINS="http://localhost:3000"

# --- AI Capability (Ch80-91, ADR 0007, ADR 0019) — left blank; the AI
#     Assistant falls back to KeywordAssistantResponder's FAQ-only replies
#     until this is configured. Classification and provider ranking are
#     deterministic (no ML provider needed) — see ADR 0019. ---
ANTHROPIC_API_KEY=""
AI_ASSISTANT_MODEL="claude-sonnet-4-5"
AI_ASSISTANT_MAX_COST_USD_PER_CONVERSATION="1.00"
AI_ASSISTANT_MAX_MESSAGES_PER_CONVERSATION="40"

# --- SOS & Safety (Ch55, ADR 0021) ---
# Displayed to a user after they trigger an SOS alert — this bootstrap has no
# real emergency-dispatch integration, so this is purely informational text
# telling them to contact real emergency services themselves.
EMERGENCY_SERVICES_NUMBER="112"

# --- apps/web (Next.js Admin Console) ---
# Server-only (no NEXT_PUBLIC_ prefix) — the browser never calls apps/api
# directly. Every page is a Server Component/Server Action that calls this
# from the Next.js server itself (a BFF pattern), keeping the httpOnly
# session cookie and this URL both off the client entirely.
MOTIQ_API_BASE_URL="http://localhost:3001/api/v1"

# --- apps/mobile (Expo — Customer/Provider apps, Ch64-74, ADR 0018) ---
# Expo reads EXPO_PUBLIC_* at build time and inlines it into the JS bundle —
# never put a secret here, only public client config (same rule as
# NEXT_PUBLIC_* above). Point at a LAN IP, not localhost, when testing on a
# physical device via Expo Go.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3001/api/v1"
EXPO_PUBLIC_WS_URL="http://localhost:3001"
