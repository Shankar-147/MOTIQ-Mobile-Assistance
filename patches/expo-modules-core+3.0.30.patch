diff --git a/node_modules/expo-modules-core/android/build.gradle b/node_modules/expo-modules-core/android/build.gradle
index 80cee5d..1a2b3c4 100644
--- a/node_modules/expo-modules-core/android/build.gradle
+++ b/node_modules/expo-modules-core/android/build.gradle
@@ -2,6 +2,7 @@
 import expo.modules.plugin.gradle.ExpoModuleExtension
 import groovy.json.JsonSlurper
 import org.jetbrains.kotlin.gradle.tasks.KotlinCompile
+import org.apache.tools.ant.taskdefs.condition.Os

 buildscript {
   // List of features that are required by linked modules
@@ -89,6 +90,10 @@ android {
       cmake {
         abiFilters(*reactNativeArchitectures())
         arguments "-DANDROID_STL=c++_shared",
+          // See react-native-worklets/android/build.gradle's identical
+          // comment: this machine's CMake drops -lc++_shared from the
+          // generated link line for this NDK, forced back explicitly.
+          "-DCMAKE_SHARED_LINKER_FLAGS=-lc++_shared",
           "-DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON",
           "-DREACT_NATIVE_DIR=${expoModuleExtension.reactNativeDir}",
           "-DREACT_NATIVE_TARGET_VERSION=${expoModuleExtension.reactNativeVersion.minor}",
@@ -102,6 +107,18 @@ android {
   externalNativeBuild {
     cmake {
       path "CMakeLists.txt"
+      // Force CMake 3.31.6 (bundles ninja 1.12.1) instead of the SDK's
+      // "default" CMake 3.22.1, which bundles ninja 1.10.2 — an old ninja
+      // with documented Windows response-file/path-handling bugs that were
+      // silently dropping linker args (libc++_shared symbols) on this build.
+      // See docs.swmansion.com/react-native-reanimated/docs/guides/building-on-windows
+      // ("Ninja: Requires 1.12.0+, older versions have path-handling issues").
+      // Windows-only: EAS Build's Linux images don't have 3.31.6 in their SDK
+      // component cache ([CXX1300] CMake not found), and Linux's ninja doesn't
+      // have this bug, so there's nothing to work around there.
+      if (Os.isFamily(Os.FAMILY_WINDOWS)) {
+        version "3.31.6"
+      }
     }
   }

