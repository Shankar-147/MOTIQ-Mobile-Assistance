// MOTIQ data model. Mirrors docs/domain-model.md exactly — if you change one, change both.
// PostGIS geography columns are declared `Unsupported(...)` because Prisma's schema DSL doesn't
// natively model them; they are queried via $queryRaw only. See docs/decisions/0002-*.md and
// prisma/migrations/*_add_postgis/migration.sql for the hand-written column/index definitions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // `prisma migrate dev`'s shadow database needs PostGIS enabled on it too
  // (Unsupported geography columns fail to validate otherwise, ADR 0002) —
  // Prisma creates/drops a fresh shadow DB by default with no way to run our
  // pre-migration extension script against it first, so this points at a
  // persistent one instead, set up once with the same PostGIS extension.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPPORT
}

enum VehicleType {
  TWO_WHEELER
  CAR
  COMMERCIAL
}

/// Ch2 §2.4.2 — binding, verbatim breakdown taxonomy.
enum IssueType {
  TOW
  REPAIR
  FUEL
  FLAT_TYRE
  BATTERY_JUMP
  OTHER
}

/// Ch19 — the canonical Service Request state machine. See ADR 0004.
enum RequestStatus {
  REQUESTED
  MATCHING
  ASSIGNED
  PROVIDER_ACCEPTED
  PROVIDER_EN_ROUTE
  ARRIVED
  SERVICE_IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROVIDER
  EXPIRED
  FAILED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  TIMED_OUT
}

/// Ch98 — never a boolean. See ADR 0005.
enum ProviderVerificationStatus {
  UNVERIFIED
  PROVISIONAL
  FULLY_VERIFIED
  SUSPENDED
  DELISTED
}

enum PresenceStatus {
  OFFLINE
  ONLINE
  BUSY
}

/// Separate from RequestStatus by design — see ADR 0004.
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// Ch7 §7.6.2 — the four-phase cold-start playbook.
enum ServiceAreaLaunchPhase {
  SUPPLY_SEEDING
  CONTROLLED_DEMAND
  LIQUIDITY_GROWTH
  STEADY_STATE
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
}

/// Ch79 — SOS/safety notifications are always CRITICAL, never best-effort.
enum NotificationDeliveryTier {
  CRITICAL
  BEST_EFFORT
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  /// Ch59 preference/quiet-hours suppression. Never used for CRITICAL tier — see ADR 0017.
  SUPPRESSED
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum VerificationDocumentType {
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  IDENTITY_PROOF
  ADDRESS_PROOF
  OTHER
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  adminProfile    AdminProfile?
  auditLogs       AuditLog[]     @relation("ActorAuditLogs")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  reviewedVerificationDocuments ProviderVerificationDocument[]
  pushDeviceTokens        PushDeviceToken[]
  notificationPreference  NotificationPreference?
  aiConversations         AiConversation[]
  consentRecords          ConsentRecord[]
  sosAlerts               SosAlert[]

  @@map("users")
}

/// Ch70 — a user may have more than one device (phone + tablet); tokens are
/// upserted by value so a re-registered token never duplicates a row.
model PushDeviceToken {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String         @unique
  platform     DevicePlatform
  createdAt    DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())

  @@index([userId])
  @@map("push_device_tokens")
}

/// Ch59 — per-user channel opt-outs and quiet hours. CRITICAL-tier
/// notifications (Ch79's SOS/safety carve-out) always bypass both — see
/// notification-preference.util.ts and ADR 0017.
model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsEnabled       Boolean  @default(true)
  pushEnabled      Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  /// Local-hour-of-day (0-23) window, inclusive of start, exclusive of end,
  /// wrapping past midnight if start > end. Null on either means no quiet hours set.
  quietHoursStartHour Int?
  quietHoursEndHour   Int?
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

enum AiConversationMessageRole {
  USER
  ASSISTANT
}

/// Ch90's AI Assistant conversation container. `emergencyDetected`/`escalated`
/// exist so a support agent (or a future audit, Ch91) can see at a glance
/// which conversations left the assistant's normal path — see ADR 0019.
model AiConversation {
  id                String                  @id @default(uuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyDetected Boolean                 @default(false)
  escalated         Boolean                 @default(false)
  /// Ch90's mandatory cost cap — cumulative estimated USD cost across every
  /// assistant reply in this conversation. See ai-cost.util.ts.
  estimatedCostUsd  Decimal                 @default(0) @db.Decimal(8, 4)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  messages AiConversationMessage[]

  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String                    @id @default(uuid())
  conversationId String
  conversation   AiConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiConversationMessageRole
  content        String
  createdAt      DateTime                  @default(now())

  @@index([conversationId])
  @@map("ai_conversation_messages")
}

/// Ch33 — refresh-token rotation, required. Opaque random tokens (not JWTs),
/// stored only as a hash, so a token is actually revocable — see ADR 0011.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Ch50 — OTP for phone-first Customer/Provider login and registration.
/// Not linked to User by FK: the phone may not have a User yet (registration).
model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, consumedAt])
  @@map("otp_challenges")
}

model CustomerProfile {
  id                   String       @id @default(uuid())
  userId               String       @unique
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  preferredLanguage    String       @default("en")
  defaultServiceAreaId String?
  defaultServiceArea   ServiceArea? @relation(fields: [defaultServiceAreaId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  vehicles        Vehicle[]
  serviceRequests ServiceRequest[]
  ratingsGiven    Rating[]         @relation("CustomerRatings")

  @@map("customer_profiles")
}

model ProviderProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  serviceAreaId      String
  serviceArea        ServiceArea                @relation(fields: [serviceAreaId], references: [id])
  verificationStatus ProviderVerificationStatus @default(UNVERIFIED)
  /// Ch98's re-verification cadence: when the current tier was last granted.
  /// Null for a provider who has never been PROVISIONAL/FULLY_VERIFIED. See ADR 0016.
  lastVerifiedAt     DateTime?
  presenceStatus     PresenceStatus             @default(OFFLINE)
  lastSeenAt         DateTime?
  ratingAverage      Decimal                    @default(0) @db.Decimal(3, 2)
  completedJobCount  Int                        @default(0)
  /// Ch58 — Bayesian-adjusted rating x verification-tier multiplier, feeding
  /// Ch84's future ranking model. Recomputed by ProviderService whenever
  /// ratingAverage/completedJobCount/verificationStatus change — see ADR 0016.
  trustScore         Decimal                    @default(0) @db.Decimal(3, 2)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  currentLocation Unsupported("geography(Point,4326)")?

  fleetVehicles         ProviderFleetVehicle[]
  assignments           Assignment[]
  ratingsReceived       Rating[]                       @relation("ProviderRatings")
  locationPings         LocationPing[]
  verificationDocuments ProviderVerificationDocument[]

  @@index([serviceAreaId, verificationStatus, presenceStatus])
  @@map("provider_profiles")
}

/// Ch98's KYC document submissions. fileUrl is a client-supplied reference
/// (e.g. a pre-signed upload URL) — no real file storage/virus-scanning
/// integration exists yet (Ch94's secure-file-handling is future work), so
/// this is honestly a reference field, not a verified upload. See ADR 0016.
model ProviderVerificationDocument {
  id                String                     @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile            @relation(fields: [providerProfileId], references: [id])
  documentType      VerificationDocumentType
  fileUrl           String
  status            VerificationDocumentStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedByUser    User?                      @relation(fields: [reviewedByUserId], references: [id])
  reviewNotes       String?
  submittedAt       DateTime                   @default(now())
  reviewedAt        DateTime?

  @@index([providerProfileId, status])
  @@index([status])
  @@map("provider_verification_documents")
}

/// Ch40's raw GPS trail store, deferred from Phase 0. Plain lat/lng Floats,
/// deliberately NOT PostGIS geography — Ch39's binding rule is about the
/// nearest-provider query path (ProviderProfile.currentLocation), not every
/// location record; this table is a historical trail, never queried for
/// proximity. Composite (id, recordedAt) id, not a plain single-column PK,
/// because TimescaleDB requires any unique/primary-key constraint on a
/// hypertable to include the partitioning column — see ADR 0015.
model LocationPing {
  id                String          @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id])
  latitude          Float
  longitude         Float
  recordedAt        DateTime        @default(now())
  /// Ch99 — set when this ping implies a physically-implausible speed since
  /// the provider's previous ping (gps-spoof.util.ts). Advisory only: never
  /// blocks the tracking write path or a job's completion — see ADR 0020.
  flaggedAsSuspicious Boolean       @default(false)

  @@id([id, recordedAt])
  @@index([providerProfileId, recordedAt])
  @@map("location_pings")
}

model AdminProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?
  notes      String?
  createdAt  DateTime @default(now())

  /// Ch93 — TOTP MFA, opt-in per Admin/Support account. `mfaSecret` is the
  /// raw base32 TOTP secret (this bootstrap has no KMS to envelope-encrypt
  /// it with — see ADR 0020's honest note on that gap). `mfaEnabled` only
  /// flips true once enrollment is confirmed with a real TOTP code, so a
  /// half-finished enrollment never silently starts requiring a code the
  /// admin never confirmed they can generate.
  mfaSecret  String?
  mfaEnabled Boolean  @default(false)

  @@map("admin_profiles")
}

model Vehicle {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  vehicleType       VehicleType
  make              String
  model             String
  year              Int?
  plateNumber       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  serviceRequests ServiceRequest[]

  @@map("vehicles")
}

/// Ch37 — deliberately distinct from Vehicle; fixes the V0 naming collision.
model ProviderFleetVehicle {
  id                String          @id @default(uuid())
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  vehicleType       VehicleType
  make              String
  model             String
  plateNumber       String
  createdAt         DateTime        @default(now())

  @@map("provider_fleet_vehicles")
}

/// First-class city/launch-region entity — see ADR 0006.
model ServiceArea {
  id          String                 @id @default(uuid())
  name        String                 @unique
  launchPhase ServiceAreaLaunchPhase @default(SUPPLY_SEEDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  boundary Unsupported("geography(Polygon,4326)")?

  providers        ProviderProfile[]
  serviceRequests  ServiceRequest[]
  commissionRates  CommissionRate[]
  fareConfigs      FareConfig[]
  customerDefaults CustomerProfile[]

  @@map("service_areas")
}

/// Versioned, never a code constant — see ADR 0003.
model CommissionRate {
  id             String      @id @default(uuid())
  serviceAreaId  String
  serviceArea    ServiceArea @relation(fields: [serviceAreaId], references: [id])
  ratePercentage Decimal     @db.Decimal(5, 2)
  effectiveFrom  DateTime
  createdAt      DateTime    @default(now())

  payments Payment[]

  @@index([serviceAreaId, effectiveFrom])
  @@map("commission_rates")
}

/// Ch8/Ch56 — fare = baseFare + distanceComponent, times an (capped) surge
/// multiplier, minus promotions. Versioned per ServiceArea, same pattern as
/// CommissionRate — never a code constant (Ch34). See ADR 0012.
model FareConfig {
  id                 String      @id @default(uuid())
  serviceAreaId      String
  serviceArea        ServiceArea @relation(fields: [serviceAreaId], references: [id])
  baseFare           Decimal     @db.Decimal(10, 2)
  perKmRate          Decimal     @db.Decimal(10, 2)
  /// Ch8 — surge must be capped and explainable, never an opaque multiplier.
  maxSurgeMultiplier Decimal     @default(1.0) @db.Decimal(4, 2)
  effectiveFrom      DateTime
  createdAt          DateTime    @default(now())

  @@index([serviceAreaId, effectiveFrom])
  @@map("fare_configs")
}

model ServiceRequest {
  id                String        @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  serviceAreaId     String
  serviceArea       ServiceArea   @relation(fields: [serviceAreaId], references: [id])
  issueType         IssueType
  status            RequestStatus @default(REQUESTED)
  description       String?

  // Nullable at the Prisma-client level even though conceptually every request has one:
  // a required Unsupported field can't be supplied through Prisma's typed create() input
  // at all, which makes the client-generated create signature unconstructable. It's set
  // via the raw-SQL UPDATE immediately after creation in RequestService.create() — see
  // docs/decisions/0002-postgresql-prisma-postgis.md.
  pickupLocation Unsupported("geography(Point,4326)")?

  // Vehicle snapshot at request-creation time — see docs/domain-model.md's "Why a snapshot" note.
  vehicleId                  String?
  vehicle                    Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleSnapshotMake        String
  vehicleSnapshotModel       String
  vehicleSnapshotYear        Int?
  vehicleSnapshotPlateNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
  payment     Payment?
  rating      Rating?

  @@index([status])
  @@index([serviceAreaId, status])
  @@map("service_requests")
}

/// One offer of a ServiceRequest to one ProviderProfile — there can be several per request.
model Assignment {
  id                                      String                     @id @default(uuid())
  serviceRequestId                        String
  serviceRequest                          ServiceRequest             @relation(fields: [serviceRequestId], references: [id])
  providerProfileId                       String
  providerProfile                         ProviderProfile            @relation(fields: [providerProfileId], references: [id])
  status                                  AssignmentStatus           @default(OFFERED)
  /// Point-in-time snapshot — see ADR 0005 and Ch1 §1.6.2's Safety success layer.
  providerVerificationStatusAtAssignment ProviderVerificationStatus
  /// Straight-line (PostGIS ST_Distance) provider-to-pickup distance at offer
  /// time, in meters — not a real driving route (Ch32's Maps/routing API
  /// integration is future work). Reused as the Pricing Engine's distance
  /// input when the job completes (ADR 0012) so fare doesn't need a second,
  /// separate distance source.
  distanceMeters                          Float?
  offeredAt                               DateTime                   @default(now())
  respondedAt                             DateTime?
  /// Optimistic lock (Ch43) — prevents double-assignment race conditions.
  version                                 Int                        @default(0)

  @@index([providerProfileId, status])
  @@index([serviceRequestId])
  @@map("assignments")
}

/// Every field here is binding per Ch6/Ch57 — see ADR 0003.
model Payment {
  id                   String         @id @default(uuid())
  serviceRequestId     String         @unique
  serviceRequest       ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  commissionRateId     String
  commissionRate       CommissionRate @relation(fields: [commissionRateId], references: [id])
  totalAmount          Decimal        @db.Decimal(12, 2)
  commissionAmount     Decimal        @db.Decimal(12, 2)
  providerPayoutAmount Decimal        @db.Decimal(12, 2)
  status               PaymentStatus  @default(PENDING)
  gatewayReference     String?
  idempotencyKey       String         @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("payments")
}

model Rating {
  id                String          @id @default(uuid())
  serviceRequestId  String          @unique
  serviceRequest    ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  customerProfileId String
  customerProfile   CustomerProfile @relation("CustomerRatings", fields: [customerProfileId], references: [id])
  providerProfileId String
  providerProfile   ProviderProfile @relation("ProviderRatings", fields: [providerProfileId], references: [id])
  stars             Int
  comment           String?
  createdAt         DateTime        @default(now())

  @@map("ratings")
}

model Notification {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id])
  channel      NotificationChannel
  category     String
  deliveryTier NotificationDeliveryTier
  payload      Json
  status       NotificationStatus       @default(QUEUED)
  sentAt       DateTime?
  createdAt    DateTime                 @default(now())

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum ConsentType {
  LOCATION_TRACKING
}

/// Ch128 — explicit, versioned consent with an audit trail, required before
/// location collection begins. `version` lets a future changed consent-copy
/// require re-grant (Ch128's "consent versioning") without losing the
/// history of what was previously granted. See ADR 0020.
model ConsentRecord {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  version     Int
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?

  @@index([userId, consentType])
  @@map("consent_records")
}

enum SosAlertStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

/// Ch55 — the platform's highest-priority path. `serviceRequestId` is
/// nullable: a genuine emergency can happen before a request was ever
/// created (Ch55 bypasses normal matching-queue priority entirely — this
/// isn't matched to a provider like a ServiceRequest, it's an immediate
/// escalation to MOTIQ's own Admin/Support team). `latitude`/`longitude` are
/// nullable too — the AI Assistant's emergency pre-filter (Ch90) can trigger
/// one with no known location. See ADR 0021.
model SosAlert {
  id                String         @id @default(uuid())
  triggeredByUserId String
  triggeredByUser   User           @relation(fields: [triggeredByUserId], references: [id])
  serviceRequestId  String?
  latitude          Float?
  longitude         Float?
  status            SosAlertStatus @default(TRIGGERED)
  source            String
  acknowledgedByUserId String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  resolutionNotes   String?
  createdAt         DateTime       @default(now())

  @@index([status, createdAt])
  @@map("sos_alerts")
}
